            "defines": [
                "CORE_CM7",
                "STM32H750xx",
                "STM32H750IB",
                "ARM_MATH_CM7",
                "flash_layout",
                "HSE_VALUE=16000000",
                "USE_HAL_DRIVER",
                "USE_FULL_LL_DRIVER",
                "USE_DAISYSP_LGPL"
            ],
            "compilerPath": "C:\\Program Files\\DaisyToolchain\\bin\\arm-none-eabi-g++.exe",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m7",
                "-mfpu=fpv5-d16",
                "-mfloat-abi=hard",
                "-mthumb",
                "-fno-exceptions",
                "-fno-rtti"

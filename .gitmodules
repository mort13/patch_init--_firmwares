[submodule "lib/libDaisy"]
	path = lib/libDaisy
	url = https://github.com/daisyaudio/libDaisy
[submodule "lib/DaisySP"]
	path = lib/DaisySP
	url = https://github.com/daisyaudio/DaisySP
[submodule "lib/stmlib"]
	path = lib/stmlib
	url = https://github.com/pichenettes/stmlib
[submodule "ref/DaisyExamples"]
	path = ref/DaisyExamples
	url = https://github.com/daisyaudio/DaisyExamples
	shallow = true
[submodule "ref/eurorack"]
	path = ref/eurorack
	url = https://github.com/pichenettes/eurorack
	shallow = true
